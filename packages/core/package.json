{
  "name": "@codemind/core",
  "version": "0.1.2",
  "description": "Deterministic graph schema, query helpers, freshness checks, and Markdown renderers for CodeMind Graph.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciferyu666/codemind-graph.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/luciferyu666/codemind-graph/issues"
  },
  "homepage": "https://github.com/luciferyu666/codemind-graph#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  }
}
